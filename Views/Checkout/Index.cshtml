@model CheckoutViewModel
@{ ViewData["Title"] = "Thanh toán"; }
<div class="container page-heading"><span class="eyebrow">BƯỚC CUỐI CÙNG</span><h1>Thông tin nhận hàng</h1></div>
<div class="container checkout-layout"><form asp-action="PlaceOrder" method="post" class="checkout-form"><h3>Thông tin nhận hàng</h3><label>Họ và tên<input asp-for="ReceiverName" required /></label><label>Số điện thoại<input asp-for="Phone" required /></label><label>Địa chỉ giao hàng<textarea asp-for="Address" rows="3" required placeholder="Số nhà, đường, quận/huyện..."></textarea></label><h3 class="mt-4">Thanh toán</h3><div class="payment-option">◉ <b>Thanh toán khi nhận hàng (COD)</b><small>Nhân viên sẽ dùng thông tin này để đặt giao hàng qua đơn vị vận chuyển bên ngoài.</small></div><button class="btn btn-orange w-100 mt-4">Xác nhận đặt hàng</button></form><aside class="summary"><h3>Đơn hàng của bạn</h3>@foreach (var item in Model.Items) { <div class="order-line"><span>@item.Book.Title × @item.Quantity</span><b>@item.Subtotal.ToString("N0")đ</b></div> }<hr /><div><span>Tổng tiền sách</span><b>@Model.Subtotal.ToString("N0")đ</b></div><div class="total mt-3"><b>Tổng tiền hàng</b><strong>@Model.Total.ToString("N0")đ</strong></div></aside></div>
