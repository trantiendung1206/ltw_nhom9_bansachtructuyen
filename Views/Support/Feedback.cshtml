@model CustomerFeedbackInput
@{ ViewData["Title"] = "Góp ý"; }
<div class="container page-heading"><span class="eyebrow">LẮNG NGHE BẠN</span><h1>Góp ý cho GroupNine</h1><p>Chia sẻ trải nghiệm để chúng tôi phục vụ bạn tốt hơn.</p></div>
<div class="container support-form-wrap"><form asp-action="Feedback" method="post" class="checkout-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><label>Chủ đề<input asp-for="Subject" required maxlength="200" /></label><span asp-validation-for="Subject" class="text-danger"></span><label>Nội dung góp ý<textarea asp-for="Message" rows="7" required maxlength="2000"></textarea></label><span asp-validation-for="Message" class="text-danger"></span><button class="btn btn-orange mt-3">Gửi góp ý</button></form></div>
