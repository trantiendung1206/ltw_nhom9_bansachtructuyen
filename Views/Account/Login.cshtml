@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-page container"><div class="auth-card"><div class="auth-intro"><span class="brand-mark">GN</span><h1>Chào mừng trở lại!</h1><p>Đăng nhập để theo dõi đơn hàng và nhận ưu đãi riêng cho bạn.</p></div><form asp-action="Login" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><h2>Đăng nhập</h2><label>Email hoặc số điện thoại<input asp-for="Identifier" placeholder="email hoặc số điện thoại" autocomplete="username" /></label><span asp-validation-for="Identifier" class="text-danger"></span><label>Mật khẩu<span class="password-field"><input asp-for="Password" placeholder="••••••••" autocomplete="current-password" /><button class="password-toggle" type="button" data-password-toggle aria-label="Hiện mật khẩu" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Zm10 3.5a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Z" /><path class="eye-slash" d="m3 3 18 18" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2.2" /></svg></button></span></label><span asp-validation-for="Password" class="text-danger"></span><label class="remember"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label><input type="hidden" asp-for="ReturnUrl" /><button class="btn btn-orange w-100">Đăng nhập →</button><p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p></form></div></div>
