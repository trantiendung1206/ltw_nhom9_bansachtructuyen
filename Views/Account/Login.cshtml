@model LoginViewModel
@{ ViewData["Title"] = "Đăng nhập"; }
<div class="auth-page container"><div class="auth-card"><div class="auth-intro"><span class="brand-mark">LT</span><h1>Chào mừng trở lại!</h1><p>Đăng nhập để lưu sách yêu thích, theo dõi đơn hàng và nhận ưu đãi riêng cho bạn.</p></div><form asp-action="Login" method="post" class="auth-form"><div asp-validation-summary="ModelOnly" class="text-danger"></div><h2>Đăng nhập</h2><label>Email hoặc số điện thoại<input asp-for="Identifier" placeholder="email hoặc số điện thoại" autocomplete="username" /></label><span asp-validation-for="Identifier" class="text-danger"></span><label>Mật khẩu<input asp-for="Password" placeholder="••••••••" autocomplete="current-password" /></label><span asp-validation-for="Password" class="text-danger"></span><label class="remember"><input asp-for="RememberMe" /> Ghi nhớ đăng nhập</label><input type="hidden" asp-for="ReturnUrl" /><button class="btn btn-orange w-100">Đăng nhập →</button><p class="auth-switch">Chưa có tài khoản? <a asp-action="Register">Đăng ký ngay</a></p></form></div></div>
