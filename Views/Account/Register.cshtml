@model RegisterViewModel
@{ ViewData["Title"] = "Đăng ký"; }
<div class="auth-page container"><div class="auth-card single"><form asp-action="Register" method="post" class="auth-form"><h2>Tạo tài khoản mới</h2><p class="text-muted">Tham gia cộng đồng những người yêu sách.</p><div asp-validation-summary="ModelOnly" class="text-danger"></div><label>Họ và tên<input asp-for="FullName" autocomplete="name" /></label><span asp-validation-for="FullName" class="text-danger"></span><label>Email<input asp-for="Email" autocomplete="email" /></label><span asp-validation-for="Email" class="text-danger"></span><label>Số điện thoại<input asp-for="Phone" autocomplete="tel" /></label><span asp-validation-for="Phone" class="text-danger"></span><label>Mật khẩu<input asp-for="Password" autocomplete="new-password" /></label><small class="form-text">Ít nhất 8 ký tự, có ít nhất một chữ in hoa và một chữ số.</small><span asp-validation-for="Password" class="text-danger"></span><label>Nhập lại mật khẩu<input asp-for="ConfirmPassword" autocomplete="new-password" /></label><span asp-validation-for="ConfirmPassword" class="text-danger"></span><button class="btn btn-orange w-100 mt-3">Đăng ký tài khoản →</button><p class="auth-switch">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p></form></div></div>
