@model PromotionViewModel
@{ ViewData["Title"] = "Quản lý ưu đãi"; }
<div class="admin-top"><div><span class="admin-kicker">MARKETING</span><h1>Quản lý ưu đãi</h1><p>Giảm giá theo danh mục hoặc từng mã/tên sách.</p></div></div>
<div class="admin-panel promotion-panel">
    <h2>Chọn phạm vi áp dụng</h2>
    <form asp-action="Promotions" method="get" class="promotion-filter"><input name="q" value="@Model.Query" placeholder="Tên sách hoặc mã sách..." /><select name="category"><option value="">Tất cả danh mục</option>@foreach (var category in (IEnumerable<Category>)ViewBag.Categories) { <option selected="@(category.Name == Model.Category)" value="@category.Name">@category.Name</option> }</select><button class="admin-secondary">Lọc sách</button></form>
    <form asp-action="ApplyPromotion" method="post" class="promotion-form" onsubmit="return confirm('Bạn có chắc muốn áp dụng ưu đãi cho @Model.Books.Count sách phù hợp với bộ lọc hiện tại không?');"><input type="hidden" name="Query" value="@Model.Query" /><input type="hidden" name="Category" value="@Model.Category" /><label>Giảm theo phần trăm (%)<input asp-for="DiscountPercent" type="number" min="0" max="100" placeholder="Ví dụ: 20" /></label><span class="or">hoặc</span><label>Giảm trực tiếp (VNĐ)<input asp-for="DiscountAmount" type="number" min="0" placeholder="Ví dụ: 30000" /></label><button class="admin-primary">Áp dụng cho @Model.Books.Count sách</button></form>
</div>
<div class="admin-panel"><div class="panel-heading"><div><h2>Danh sách áp dụng</h2><p>@Model.Books.Count sách phù hợp với bộ lọc</p></div></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Sách</th><th>Giá gốc</th><th>Ưu đãi hiện tại</th><th>Giá sau giảm</th><th></th></tr></thead><tbody>@foreach (var book in Model.Books) { <tr><td>#@book.Id</td><td><b>@book.Title</b><small>@book.Category</small></td><td>@book.Price.ToString("N0")đ</td><td>@(book.DiscountAmount > 0 ? $"-{book.DiscountAmount:N0}đ" : book.DiscountPercent > 0 ? $"-{book.DiscountPercent}%" : "Chưa giảm")</td><td class="money">@book.SalePrice.ToString("N0")đ</td><td><form asp-action="ClearPromotion" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa ưu đãi của sách “@book.Title” không?');"><button class="clear-discount">Xóa ưu đãi</button></form></td></tr>}</tbody></table></div></div>
