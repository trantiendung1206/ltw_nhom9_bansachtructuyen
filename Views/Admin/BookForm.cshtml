@model Book
@{ var editing = Model.Id > 0; ViewData["Title"] = editing ? "Sửa sách" : "Thêm sách"; }
<div class="admin-top"><div><span class="admin-kicker">KHO SÁCH</span><h1>@ViewData["Title"]</h1></div><a class="admin-back" asp-action="Books">← Danh sách sách</a></div>
@{ var categories = ViewBag.Categories as IEnumerable<Category> ?? []; }
<form asp-action="@(editing ? "EditBook" : "CreateBook")" asp-route-id="@Model.Id" method="post" class="admin-panel admin-form">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="form-grid">
        <label>Tên sách<input asp-for="Title" required /><span asp-validation-for="Title" class="text-danger"></span></label>
        <label>Tác giả<input asp-for="Author" required /><span asp-validation-for="Author" class="text-danger"></span></label>
        <label>Danh mục<select asp-for="Category" required><option value="">-- Chọn danh mục --</option>@foreach (var category in categories) { <option value="@category.Name">@category.Name</option> }</select><span asp-validation-for="Category" class="text-danger"></span></label>
        <label>Mã / ISBN hiển thị<input value="@(editing ? Model.Id.ToString() : "Tự động")" disabled /></label>
        <label>Giá niêm yết<input asp-for="Price" type="number" min="0" required /><span asp-validation-for="Price" class="text-danger"></span></label>
        <label>Giảm giá (%)<input asp-for="DiscountPercent" type="number" min="0" max="100" /><span asp-validation-for="DiscountPercent" class="text-danger"></span></label>
        <label>Giảm trực tiếp (VNĐ)<input asp-for="DiscountAmount" type="number" min="0" /><span asp-validation-for="DiscountAmount" class="text-danger"></span></label>
        <label>Tồn kho<input asp-for="Stock" type="number" min="0" required /><span asp-validation-for="Stock" class="text-danger"></span></label>
        <label>Ảnh bìa URL<input asp-for="CoverImage" /><span asp-validation-for="CoverImage" class="text-danger"></span></label>
        <label class="full">Mô tả<textarea asp-for="Description" rows="5"></textarea><span asp-validation-for="Description" class="text-danger"></span></label>
    </div>
    <div class="form-actions"><a class="admin-back" asp-action="Books">Hủy</a><button type="submit" class="admin-primary">Lưu thông tin</button></div>
</form>
