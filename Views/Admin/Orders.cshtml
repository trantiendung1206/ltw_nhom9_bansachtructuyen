@model IEnumerable<Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; var selectedStatus = ViewBag.Status as string ?? ""; }
<div class="admin-top"><div><span class="admin-kicker">VẬN HÀNH</span><h1>Quản lý đơn hàng</h1><p>Đơn hàng chỉ được chuyển trạng thái theo đúng quy trình.</p></div></div>
<div class="admin-panel"><nav class="order-filters"><a class="@(selectedStatus == "" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query">Tất cả</a><a class="@(selectedStatus == "Cần xác nhận" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Cần xác nhận">Đang chờ xử lý</a><a class="@(selectedStatus == "Đã xác nhận đơn hàng" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đã xác nhận đơn hàng">Đã xác nhận</a><a class="@(selectedStatus == "Đã đóng gói - chờ vận chuyển" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đã đóng gói - chờ vận chuyển">Đã đóng gói</a><a class="@(selectedStatus == "Đang vận chuyển" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đang vận chuyển">Đang vận chuyển</a><a class="@(selectedStatus == "Hoàn tất" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Hoàn tất">Hoàn tất</a><a class="@(selectedStatus == "Đã trả hàng" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đã trả hàng">Đã trả hàng</a><a class="@(selectedStatus == "Đã hủy" ? "active" : "")" asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đã hủy">Đã hủy</a></nav><form class="admin-search order-search"><input name="q" value="@ViewBag.Query" placeholder="Tìm mã đơn, tên khách, số điện thoại hoặc tên sách..." /><input type="hidden" name="status" value="@selectedStatus" /><button>Tìm kiếm</button></form><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Khách hàng</th><th>Tổng tiền</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><b>#@order.Id.ToString("D8")</b></td><td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><b>@order.ReceiverName</b><small>@order.Phone</small></td><td><b class="money">@order.Total.ToString("N0")đ</b></td><td><span class="state @(order.Status == "Hoàn tất" || order.Status == "Đã trả hàng" ? "on" : order.Status == "Đã hủy" ? "off" : "")">@order.Status</span></td><td><a class="admin-secondary" asp-action="OrderDetails" asp-route-id="@order.Id">Chi tiết đơn hàng</a></td></tr>}</tbody></table></div></div>
