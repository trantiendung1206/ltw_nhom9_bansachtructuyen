@model IEnumerable<Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; }
<div class="admin-top"><div><span class="admin-kicker">VẬN HÀNH</span><h1>Quản lý đơn hàng</h1><p>Theo dõi và cập nhật trạng thái đơn hàng.</p></div></div>
<div class="admin-panel"><form class="admin-search order-search"><input name="q" value="@ViewBag.Query" placeholder="Tìm mã đơn, tên khách, số điện thoại hoặc tên sách..." /><button>Tìm kiếm</button></form><div class="order-filters"><a asp-action="Orders" asp-route-q="@ViewBag.Query">Tất cả</a><a asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đang xử lý">Đang xử lý</a><a asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đã đóng gói - chờ vận chuyển">Đã đóng gói</a><a asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Đang vận chuyển">Đang vận chuyển</a><a asp-action="Orders" asp-route-q="@ViewBag.Query" asp-route-status="Hoàn tất">Hoàn tất</a></div><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã đơn</th><th>Khách nhận</th><th>Sản phẩm</th><th>Tổng tiền</th><th>Hình thức</th><th>Trạng thái</th><th>Ngày đặt</th></tr></thead><tbody>@foreach (var order in Model) { <tr><td><b>#@order.Id.ToString("D8")</b></td><td><b>@order.ReceiverName</b><small>@order.Phone</small></td><td>@string.Join(", ", order.Items.Select(i => $"{i.BookTitle} x{i.Quantity}"))</td><td><b class="money">@order.Total.ToString("N0")đ</b></td><td>Giao tận nơi</td><td><form asp-action="UpdateOrderStatus" asp-route-id="@order.Id" method="post" class="status-edit"><input type="hidden" name="q" value="@ViewBag.Query" /><select name="status">@foreach (var status in new[] {"Đang xử lý", "Đã đóng gói - chờ vận chuyển", "Đang vận chuyển", "Hoàn tất", "Đã hủy"}) { <option selected="@(status == order.Status)" value="@status">@status</option> }</select><button class="save-status" type="submit">Xác nhận lưu</button></form></td><td>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></div>
