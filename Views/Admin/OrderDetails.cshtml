@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; var history = ViewBag.History as IEnumerable<OrderStatusHistory> ?? []; var next = Model.Status switch { "Cần xác nhận" => "Xác nhận đơn hàng", "Đã xác nhận đơn hàng" => "Đóng gói thành công - chờ vận chuyển", "Đã đóng gói - chờ vận chuyển" => "Đang vận chuyển", "Đang vận chuyển" => "Hoàn tất đơn hàng", _ => "" }; }
<div class="admin-top"><div><span class="admin-kicker">ĐƠN HÀNG #@Model.Id.ToString("D8")</span><h1>Chi tiết đơn hàng</h1></div><a class="admin-back" asp-action="Orders">← Quản lý đơn hàng</a></div>
<div class="admin-panel"><div class="form-grid"><div><b>Mã đơn</b><p>#@Model.Id.ToString("D8")</p></div><div><b>Ngày đặt</b><p>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p></div><div><b>Khách hàng</b><p>@Model.ReceiverName - @Model.Phone</p></div><div><b>Địa chỉ nhận hàng</b><p>@Model.Address</p></div></div><h3>Sản phẩm</h3><table class="admin-table"><thead><tr><th>Sản phẩm</th><th>Số lượng</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><td>@item.BookTitle</td><td>@item.Quantity</td><td>@item.UnitPrice.ToString("N0")đ</td><td>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</td></tr>}</tbody></table><p class="text-end"><b>Tổng tiền: @Model.Total.ToString("N0")đ</b></p><h3>Lịch trình</h3><table class="admin-table"><thead><tr><th>Thời gian</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in history) { <tr><td>@item.OccurredAt.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Action</td></tr>}</tbody></table><div class="form-actions">@if (!string.IsNullOrEmpty(next)) { <form asp-action="AdvanceOrder" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Xác nhận: @next?')"><button class="admin-primary">@next</button></form> } @if (Model.Status != "Hoàn tất" && Model.Status != "Đã hủy" && Model.Status != "Đã trả hàng") { <form asp-action="CancelOrder" asp-route-id="@Model.Id" method="post" onsubmit="var r=prompt('Nhập lý do hủy đơn hàng:'); if (!r || !r.trim()) return false; this.querySelector('[name=reason]').value=r; return confirm('Xác nhận hủy đơn hàng?')"><input type="hidden" name="reason" /><button class="admin-secondary">Hủy đơn hàng</button></form> }</div></div>
