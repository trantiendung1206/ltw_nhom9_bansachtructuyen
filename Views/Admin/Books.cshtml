@model IEnumerable<Book>
@{ ViewData["Title"] = "Quản lý sách"; }
<div class="admin-top"><div><span class="admin-kicker">KHO SÁCH</span><h1>Quản lý sách</h1><p>Thêm, sửa, tìm kiếm và cập nhật tồn kho sách.</p></div><a class="admin-primary" asp-action="CreateBook">＋ Thêm sách</a></div>
<div class="admin-panel"><form class="admin-search"><input name="q" value="@Context.Request.Query["q"]" placeholder="Tìm theo tên sách hoặc mã sách..." /><button>Tìm kiếm</button></form><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã</th><th>Sách</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var book in Model) { <tr><td>#@book.Id</td><td><b>@book.Title</b><small>@book.Author</small></td><td>@book.Category</td><td>@book.Price.ToString("N0")đ</td><td><span class="stock-number @(book.Stock < 10 ? "low" : "")">@book.Stock</span></td><td><span class="state @(book.Stock > 0 ? "on" : "off")">@(book.Stock > 0 ? "Còn hàng" : "Hết hàng")</span></td><td class="action-cell"><a asp-action="EditBook" asp-route-id="@book.Id">Sửa</a><form asp-action="DeleteBook" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Xóa sách này?')"><button class="danger">Xóa</button></form></td></tr>}</tbody></table></div></div>
