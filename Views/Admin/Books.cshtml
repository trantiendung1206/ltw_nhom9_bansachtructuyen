@model AdminBookListViewModel
@{
    ViewData["Title"] = "Quản lý sách";
}
<div class="admin-top">
    <div><span class="admin-kicker">KHO SÁCH</span><h1>Quản lý sách</h1><p>Thêm, sửa, tìm kiếm và cập nhật tồn kho sách.</p></div>
    <a class="admin-primary" asp-action="CreateBook">＋ Thêm sách</a>
</div>
@if (TempData["Message"] is string message)
{
    <div class="alert alert-warning">@message</div>
}
<div class="admin-panel">
    <form class="admin-search" asp-action="Books" method="get">
        <input name="q" value="@Model.Query" placeholder="Tìm theo tên sách hoặc mã sách..." />
        <button type="submit">Tìm kiếm</button>
    </form>
    <div class="table-responsive">
        <table class="admin-table">
            <thead><tr><th>Mã</th><th>Sách</th><th>Danh mục</th><th>Giá</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                @foreach (var book in Model.Books)
                {
                    <tr>
                        <td>#@book.Id</td>
                        <td><b>@book.Title</b><small>@book.Author</small></td>
                        <td>@book.Category</td>
                        <td>@book.Price.ToString("N0")đ</td>
                        <td><span class="stock-number @(book.Stock < 10 ? "low" : "")">@book.Stock</span></td>
                        <td><span class="state @(book.Stock > 0 ? "on" : "off")">@(book.Stock > 0 ? "Còn hàng" : "Hết hàng")</span></td>
                        <td class="action-cell">
                            <a asp-action="BookDetails" asp-route-id="@book.Id">Chi tiết</a>
                            <a asp-action="EditBook" asp-route-id="@book.Id">Sửa</a>
                            <form asp-action="DeleteBook" asp-route-id="@book.Id" method="post" onsubmit="return confirm('Xóa sách này?')">
                                <button class="danger" type="submit">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (Model.Books.Count == 0)
                {
                    <tr><td colspan="7" class="text-center">Không tìm thấy sách.</td></tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang sách quản trị">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Books" asp-route-q="@Model.Query" asp-route-page="@(Model.Page - 1)">Trước</a>
                </li>
                <li class="page-item disabled"><span class="page-link">@Model.Page / @Model.TotalPages</span></li>
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Books" asp-route-q="@Model.Query" asp-route-page="@(Model.Page + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
