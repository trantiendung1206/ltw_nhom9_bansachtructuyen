@model IEnumerable<ReturnRequest>
@{ ViewData["Title"] = "Xử lý trả hàng"; var search = (ViewBag.Query as string)?.Trim() ?? ""; var codeSearch = search.TrimStart('#'); }
<div class="admin-top"><div><span class="admin-kicker">CHĂM SÓC KHÁCH HÀNG</span><h1>Xử lý trả hàng</h1><p>Kiểm tra lịch sử đơn, lý do và quyết định hoàn tiền, hoàn tồn kho.</p></div></div>
<div class="admin-panel"><form class="admin-search return-search"><input name="q" value="@ViewBag.Query" placeholder="Tìm mã yêu cầu, mã đơn, tên sách, tên khách, số điện thoại hoặc email..." /><button>Tìm kiếm</button></form><div class="table-responsive"><table class="admin-table return-table"><thead><tr><th>Mã yêu cầu</th><th>Mã đơn</th><th>Sản phẩm</th><th>Khách hàng</th><th>Lý do khách trả</th><th>Trạng thái</th><th>Thao tác xử lý</th></tr></thead><tbody>@foreach (var item in Model) { var matchingItems = item.Order?.Items.Where(orderItem => string.IsNullOrEmpty(search) || (int.TryParse(codeSearch, out _) ? false : orderItem.BookTitle.Contains(search, StringComparison.OrdinalIgnoreCase))).ToList() ?? []; if (matchingItems.Count == 0) matchingItems = item.Order?.Items.ToList() ?? []; <tr><td><b>#@item.Id.ToString("D8")</b><small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td><b>#@item.OrderId.ToString("D8")</b></td><td>@foreach (var product in matchingItems) { <small>@product.BookTitle × @product.Quantity</small> }</td><td><b>@item.Order?.ReceiverName</b><small>@item.CustomerPhone</small><small>@item.CustomerEmail</small></td><td>@item.Reason@if (!string.IsNullOrWhiteSpace(item.RejectionReason)) { <small class="rejection-reason">Lý do từ chối: @item.RejectionReason</small> }</td><td><span class="state @(item.Status.StartsWith("Chấp nhận") ? "on" : item.Status == "Từ chối yêu cầu trả hàng" ? "off" : "")">@item.Status</span></td><td>@if (item.Status == "Chờ xác nhận") { <div class="return-actions"><form asp-action="AcceptReturn" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xác nhận chấp nhận yêu cầu, hoàn tiền và cộng lại tồn kho?')"><input type="hidden" name="q" value="@ViewBag.Query" /><button class="save-status">Chấp nhận</button></form><form asp-action="RejectReturn" asp-route-id="@item.Id" method="post" class="reject-form"><input type="hidden" name="q" value="@ViewBag.Query" /><input name="reason" required maxlength="1000" placeholder="Lý do không chấp nhận" /><button class="reject-status" type="submit">Không chấp nhận</button></form></div> } else { <a class="admin-secondary" asp-action="OrderDetails" asp-route-id="@item.OrderId">Xem đơn hàng</a> }</td></tr>}</tbody></table></div></div>
