@model IEnumerable<ReturnRequest>
@{ ViewData["Title"] = "Xử lý trả hàng"; }
<div class="admin-top"><div><span class="admin-kicker">CHĂM SÓC KHÁCH HÀNG</span><h1>Xử lý trả hàng</h1><p>Kiểm tra lịch sử đơn, lý do và xác nhận yêu cầu hoàn tiền.</p></div></div>
<div class="admin-panel"><form class="admin-search return-search"><input name="q" value="@ViewBag.Query" placeholder="Tìm mã yêu cầu, mã đơn, tên, số điện thoại hoặc email..." /><button>Tìm kiếm</button></form><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã yêu cầu</th><th>Mã đơn</th><th>Khách hàng</th><th>Lý do</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><b>#@item.Id.ToString("D8")</b><small>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></td><td><b>#@item.OrderId.ToString("D8")</b></td><td><b>@item.Order?.ReceiverName</b><small>@item.CustomerPhone</small><small>@item.CustomerEmail</small></td><td>@item.Reason</td><td><span class="state @(item.Status.StartsWith("Chấp nhận") ? "on" : item.Status == "Từ chối yêu cầu trả hàng" ? "off" : "")">@item.Status</span></td><td>@if (item.Status == "Chờ xác nhận") { <form asp-action="UpdateReturnStatus" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Xác nhận chấp nhận yêu cầu trả hàng và hoàn tiền?')"><input type="hidden" name="q" value="@ViewBag.Query" /><button class="save-status">Xác nhận</button></form> } else { <a class="admin-secondary" asp-action="OrderDetails" asp-route-id="@item.OrderId">Xem đơn hàng</a> }</td></tr>}</tbody></table></div></div>
