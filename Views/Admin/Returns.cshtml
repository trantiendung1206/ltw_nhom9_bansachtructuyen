@model IEnumerable<ReturnRequest>
@{ ViewData["Title"] = "Xử lý đổi trả"; }
<div class="admin-top"><div><span class="admin-kicker">CHĂM SÓC KHÁCH HÀNG</span><h1>Xử lý đổi trả</h1><p>Xem lý do và liên hệ khách hàng để giải quyết yêu cầu.</p></div></div>
<div class="admin-panel"><form class="admin-search return-search"><input name="q" value="@ViewBag.Query" placeholder="Tìm mã yêu cầu, mã đơn, tên, số điện thoại hoặc email..." /><button>Tìm kiếm</button></form><div class="table-responsive"><table class="admin-table"><thead><tr><th>Mã yêu cầu</th><th>Mã đơn</th><th>Khách hàng</th><th>Yêu cầu</th><th>Lý do</th><th>Trạng thái</th><th>Ngày gửi</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><b>#@item.Id.ToString("D8")</b></td><td><b>#@item.OrderId.ToString("D8")</b></td><td><b>@item.Order?.ReceiverName</b><small>@item.CustomerPhone</small><small>@item.CustomerEmail</small></td><td>@item.RequestType</td><td>@item.Reason</td><td><form asp-action="UpdateReturnStatus" asp-route-id="@item.Id" method="post" class="status-edit"><input type="hidden" name="q" value="@ViewBag.Query" /><select name="status">@foreach (var status in new[] {"Chờ xác nhận", "Đã xác nhận", "Đã từ chối"}) { <option selected="@(status == item.Status)" value="@status">@status</option> }</select><button class="save-status" type="submit">Xác nhận lưu</button></form></td><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>}</tbody></table></div></div>
