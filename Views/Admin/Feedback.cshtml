@model IEnumerable<CustomerFeedback>
@{ ViewData["Title"] = "Góp ý khách hàng"; }
<div class="admin-top"><div><span class="admin-kicker">CHĂM SÓC KHÁCH HÀNG</span><h1>Góp ý khách hàng</h1><p>Tiếp nhận và xử lý phản hồi từ khách hàng.</p></div></div>
<div class="admin-panel"><div class="table-responsive"><table class="admin-table"><thead><tr><th>Chủ đề</th><th>Nội dung</th><th>Khách gửi</th><th>Ngày gửi</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td><b>@item.Subject</b></td><td>@item.Message</td><td><small>@item.CustomerEmail</small></td><td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td><td><form asp-action="UpdateFeedbackStatus" asp-route-id="@item.Id" method="post" class="status-edit"><select name="status">@foreach (var status in new[] {"Chưa xử lý", "Đang xử lý", "Đã phản hồi"}) { <option selected="@(status == item.Status)" value="@status">@status</option> }</select><button class="save-status" type="submit">Xác nhận lưu</button></form></td></tr>}</tbody></table></div></div>
