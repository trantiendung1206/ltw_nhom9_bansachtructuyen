@model Book
@{ ViewData["Title"] = Model.Title; }
<div class="container detail-page"><div class="row g-5"><div class="col-md-5 text-center"><img class="detail-cover" src="@Model.CoverImage" alt="@Model.Title" /></div><div class="col-md-7 detail-copy"><span class="eyebrow">@Model.Category</span><h1>@Model.Title</h1><p class="author">Tác giả: <b>@Model.Author</b></p><div class="stars large">★ @Model.Rating <span>(128 lượt đánh giá)</span></div><div class="detail-price">@Model.SalePrice.ToString("N0")đ @if (Model.DiscountPercent > 0 || Model.DiscountAmount > 0) { <del>@Model.Price.ToString("N0")đ</del> }</div><p>@Model.Description</p><p class="stock">✓ Còn @Model.Stock cuốn trong kho</p>@if (User.Identity?.IsAuthenticated == true) { <div class="d-flex gap-3"><form asp-controller="Cart" asp-action="Add" method="post" class="d-flex gap-3"><input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" /><input type="number" name="quantity" value="1" min="1" max="@Model.Stock" class="quantity" /><button class="btn btn-orange">Thêm vào giỏ hàng →</button></form><form asp-controller="Wishlist" asp-action="Add" method="post"><input type="hidden" name="bookId" value="@Model.Id" /><input type="hidden" name="returnUrl" value="@($"{Context.Request.Path}{Context.Request.QueryString}")" /><button class="btn favorite-large @(ViewBag.IsWishlisted == true ? "is-favorite" : "")">@(ViewBag.IsWishlisted == true ? "♥ Đã yêu thích" : "♡ Yêu thích")</button></form></div> } else { <a class="btn btn-orange" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@($"{Context.Request.Path}{Context.Request.QueryString}")">Đăng nhập để đặt mua →</a> }</div></div></div>
