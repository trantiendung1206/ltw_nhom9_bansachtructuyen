@model sc.Models.BookCatalogViewModel
@{
    ViewData["Title"] = "Danh sách sách";
}

<section class="container py-4">
    <header class="catalog-heading">
        <div>
            <span class="catalog-eyebrow">GÓC ĐỌC CỦA BẠN</span>
            <h1>Khám phá sách</h1>
            <p>Tìm cuốn sách phù hợp với bạn.</p>
        </div>
        <span class="catalog-heading-icon" aria-hidden="true"><span></span></span>
    </header>

    <form id="book-catalog-filter" asp-controller="Books" asp-action="Index" method="get" class="catalog-filter">
        <div class="catalog-search-row">
            <label class="catalog-search-box" for="catalog-query">
                <span class="catalog-search-icon" aria-hidden="true"></span>
                <input id="catalog-query" name="q" value="@Model.Query" type="search"
                       placeholder="Tìm theo tên sách hoặc tác giả..." autocomplete="off">
            </label>
        </div>

        <fieldset class="catalog-categories">
            <legend>Danh mục <span>Chọn một hoặc nhiều mục</span></legend>
            <div class="catalog-category-options">
                @foreach (var category in StoreData.Categories)
                {
                    var categoryId = $"catalog-category-{Array.IndexOf(StoreData.Categories, category)}";
                    <label class="catalog-category-chip" for="@categoryId">
                        <input id="@categoryId" name="category" type="checkbox" value="@category"
                               checked="@Model.Categories.Contains(category)">
                        <span class="catalog-check" aria-hidden="true"></span>
                        <span>@category</span>
                    </label>
                }
            </div>
        </fieldset>

        <div class="catalog-options">
            <label class="catalog-sort" for="catalog-sort">
                <span>Sắp xếp theo</span>
                <select id="catalog-sort" name="sort">
                    <option value="new" selected="@(Model.Sort == "new")">Mới nhất</option>
                    <option value="rating" selected="@(Model.Sort == "rating")">Đánh giá cao</option>
                    <option value="price-asc" selected="@(Model.Sort == "price-asc")">Giá tăng dần</option>
                    <option value="price-desc" selected="@(Model.Sort == "price-desc")">Giá giảm dần</option>
                </select>
            </label>

            <label class="catalog-promotion" for="catalog-promotion">
                <input id="catalog-promotion" name="promotion" type="checkbox" value="true"
                       checked="@Model.Promotion">
                <span class="catalog-toggle" aria-hidden="true"></span>
                <span>Đang khuyến mãi</span>
            </label>

            <div class="catalog-form-actions">
                <a class="catalog-reset" asp-controller="Books" asp-action="Index">Xóa bộ lọc</a>
                <button class="catalog-submit catalog-apply" type="submit">Tìm sách</button>
            </div>
        </div>
    </form>

    <div id="book-results" data-api-url="@Url.Content("~/api/books")"
         data-authenticated="@User.Identity?.IsAuthenticated.ToString().ToLowerInvariant()">
        @await Html.PartialAsync("_BookResults", Model)
    </div>
    @Html.AntiForgeryToken()
</section>

<script src="~/js/book-catalog.js" asp-append-version="true" defer></script>
