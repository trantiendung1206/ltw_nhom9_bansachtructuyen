@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container page-heading"><span class="eyebrow">LỊCH SỬ ĐƠN HÀNG</span><h1>Đơn hàng #@Model.Id.ToString("D8")</h1><p>Mã đơn hàng: <b>#@Model.Id.ToString("D8")</b></p></div>
<div class="container customer-order"><p><b>Khách nhận:</b> @Model.ReceiverName - @Model.Phone</p><p><b>Địa chỉ:</b> @Model.Address</p><p><b>Trạng thái:</b> <span class="order-status">@Model.Status</span></p><div class="customer-order-items">@foreach (var item in Model.Items) { <div><span>@item.BookTitle <b>x @item.Quantity</b></span><strong>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</strong></div> }</div><div class="customer-order-foot"><b>Tổng tiền sách: @Model.Total.ToString("N0")đ</b></div><a class="btn btn-orange mt-3" asp-action="Index">Quay lại đơn hàng</a></div>
