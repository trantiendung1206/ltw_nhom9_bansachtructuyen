@model Order
@{ ViewData["Title"] = "Chi tiết đơn hàng"; }
<div class="container page-heading"><span class="eyebrow">LỊCH SỬ ĐƠN HÀNG</span><h1>Đơn hàng #@Model.Id.ToString("D8")</h1><p>Mã đơn hàng: <b>#@Model.Id.ToString("D8")</b></p></div>
<div class="container customer-order"><p><b>Khách nhận:</b> @Model.ReceiverName - @Model.Phone</p><p><b>Địa chỉ:</b> @Model.Address</p><p><b>Trạng thái:</b> <span class="order-status">@Model.Status</span></p>@if (Model.Status == "Đã hủy" && !string.IsNullOrWhiteSpace(Model.CancellationReason)) { <p><b>Lý do hủy:</b> @Model.CancellationReason</p> }<div class="customer-order-items">@foreach (var item in Model.Items) { var rated = ((IDictionary<int, int>)ViewBag.Ratings).TryGetValue(item.BookId, out var currentRating); <div><span>@item.BookTitle <b>x @item.Quantity</b></span><strong>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</strong>@if (Model.Status == "Hoàn tất") { <form asp-controller="Orders" asp-action="Rate" method="post" class="rating-form"><input type="hidden" name="orderId" value="@Model.Id" /><input type="hidden" name="bookId" value="@item.BookId" /><label>Đánh giá: <select name="rating"><option value="">Chọn sao</option>@for (var star = 1; star <= 5; star++) { <option value="@star" selected="@(rated && currentRating == star)">@star sao</option> }</select></label><button class="btn btn-orange" type="submit">Lưu</button></form> }</div> }</div><div class="customer-order-foot"><b>Tổng tiền sách: @Model.Total.ToString("N0")đ</b></div><a class="btn btn-orange mt-3" asp-action="Index">Quay lại đơn hàng</a></div>
