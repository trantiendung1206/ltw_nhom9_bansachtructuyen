@model IEnumerable<Order>
@{ ViewData["Title"] = "Đơn hàng của tôi"; }
<div class="container page-heading"><span class="eyebrow">TÀI KHOẢN CỦA BẠN</span><h1>Lịch sử đơn hàng</h1><p>Theo dõi các đơn sách đã đặt và trạng thái giao hàng.</p></div>
<div class="container orders-page">
    @if (!Model.Any())
    {
        <div class="empty-state"><div class="empty-icon">▤</div><h2>Chưa có đơn hàng</h2><p>Đơn hàng bạn đặt sẽ được hiển thị tại đây.</p><a class="btn btn-orange mt-3" asp-controller="Books" asp-action="Index">Khám phá sách</a></div>
    }
    else
    {
        @foreach (var order in Model)
        {
            <section class="customer-order">
                <div class="customer-order-head"><div><b>Đơn hàng #@order.Id.ToString("D8")</b><small>@order.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small></div><span class="order-status">@order.Status</span></div>
                <div class="customer-order-items">@foreach (var item in order.Items) { <div><span>@item.BookTitle <b>x @item.Quantity</b></span><strong>@((item.UnitPrice * item.Quantity).ToString("N0"))đ</strong></div> }</div>
                <div class="customer-order-foot"><span>Giao tận nơi</span><b>Tổng tiền sách: @order.Total.ToString("N0")đ</b></div>
                <a class="return-link" asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Chi tiết đơn hàng</a>
                @if (order.Status == "Hoàn tất" && order.CreatedAt >= DateTime.Now.AddDays(-7) && !((IEnumerable<ReturnRequest>)ViewBag.ReturnRequests).Any(item => item.OrderId == order.Id && item.Status != "Từ chối yêu cầu trả hàng"))
                {
                    <a class="return-link" asp-controller="Support" asp-action="Return" asp-route-orderId="@order.Id">Yêu cầu trả hàng</a>
                }
                @foreach (var request in ((IEnumerable<ReturnRequest>)ViewBag.ReturnRequests).Where(item => item.OrderId == order.Id))
                {
                    <div class="return-history">Yêu cầu trả hàng - hoàn tiền: <b>@request.Status</b>@if (!string.IsNullOrWhiteSpace(request.RejectionReason)) { <small>Lý do: @request.RejectionReason</small> }</div>
                }
            </section>
        }
    }
</div>
