@model List<CartItem>
@{ ViewData["Title"] = "Giỏ hàng"; }
<div class="container page-heading"><span class="eyebrow">GIỎ HÀNG CỦA BẠN</span><h1>Đọc tiếp hành trình</h1></div>
<div class="container cart-layout">@if (Model.Count == 0) { <div class="empty-state"><div class="empty-icon">♡</div><h2>Chưa có cuốn nào, đi dạo kệ sách nhé?</h2><a class="btn btn-orange mt-3" asp-controller="Books" asp-action="Index">Khám phá sách</a></div> } else { <div class="cart-items">@foreach (var item in Model) { <div class="cart-item"><img src="@item.Book.CoverImage" alt="@item.Book.Title" /><div class="flex-grow-1"><a class="book-title" asp-controller="Books" asp-action="Details" asp-route-id="@item.Book.Id">@item.Book.Title</a><small>@item.Book.Author</small><b class="d-block mt-2">@item.Book.SalePrice.ToString("N0")đ</b></div><form asp-action="Update" method="post" class="quantity-form"><input type="hidden" name="id" value="@item.Book.Id" /><input name="quantity" type="number" value="@item.Quantity" min="1" max="@item.Book.Stock" /><button>↻</button></form><form asp-action="Remove" method="post"><input type="hidden" name="id" value="@item.Book.Id" /><button class="remove-btn">×</button></form></div>}</div><aside class="summary"><h3>Tóm tắt đơn hàng</h3><div><span>Tạm tính</span><b>@Model.Sum(x => x.Subtotal).ToString("N0")đ</b></div><div><span>Phí vận chuyển</span><span>30.000đ</span></div><hr /><div class="total"><b>Tổng cộng</b><strong>@((Model.Sum(x => x.Subtotal) + 30000).ToString("N0"))đ</strong></div><a class="btn btn-orange w-100 mt-3" asp-controller="Checkout" asp-action="Index">Tiến hành thanh toán →</a></aside> }</div>
