        <mxCell id="stat-categories" value="DANH MỤC ĐANG DÙNG&#xA;&#xA;12&#xA;nhóm sách hoạt động" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fillColor=#f5f5f5;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="860" y="164" width="240" height="116" as="geometry" /></mxCell>
        <mxCell id="stat-revenue" value="DOANH THU HOÀN TẤT&#xA;&#xA;125.000.000đ&#xA;từ 320 đơn hàng" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fillColor=#f5f5f5;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="1120" y="164" width="256" height="116" as="geometry" /></mxCell>
        <mxCell id="featured" value="SẢN PHẨM — SÁCH ĐƯỢC QUAN TÂM                         Quản lý sách&#xA;&#xA;Tên sách A — Danh mục A                                  Đánh giá 4.8&#xA;Tên sách B — Danh mục B                                  Đánh giá 4.6&#xA;Tên sách C — Danh mục C                                  Đánh giá 4.5&#xA;Tên sách D — Danh mục D                                  Chưa có đánh giá" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=20;fontFamily=Arial;fontSize=13;fillColor=#ffffff;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="340" y="296" width="632" height="256" as="geometry" /></mxCell>
        <mxCell id="best-seller" value="BÁN CHẠY NHẤT&#xA;&#xA;Sản phẩm nổi bật&#xA;*&#xA;Tên sách bán chạy&#xA;&#xA;Danh mục bán chạy: Văn học&#xA;&#xA;[ Xem đơn hàng &gt; ]" style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=14;fillColor=#f7f7f7;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="988" y="296" width="388" height="256" as="geometry" /></mxCell>
        <mxCell id="book-management" value="QUẢN LÝ SÁCH — MÀN HÌNH MODULE&#xA;Tìm theo tên sách hoặc mã sách&#xA;&#xA;Mã     Sách / Tác giả       Danh mục       Giá         Tồn kho      Trạng thái      Thao tác&#xA;#101   Tên sách A             Văn học       120.000đ       25        Còn hàng       Chi tiết | Sửa | Xóa&#xA;#102   Tên sách B             Kinh tế          90.000đ        0        Hết hàng       Chi tiết | Sửa | Xóa&#xA;&#xA;                                   Trước       1 / 20       Sau" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=18;fontFamily=Arial;fontSize=12;fillColor=#ffffff;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="340" y="568" width="1036" height="244" as="geometry" /></mxCell>
