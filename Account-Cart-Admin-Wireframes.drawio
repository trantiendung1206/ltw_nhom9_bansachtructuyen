        <mxCell id="sidebar" value="GN  GroupNine&#xA;QUẢN TRỊ HỆ THỐNG&#xA;&#xA;[1]  Thống kê hệ thống&#xA;[2]  Quản lý sách&#xA;[3]  Danh mục sách&#xA;[4]  Quản lý đơn hàng&#xA;[5]  Xử lý trả hàng&#xA;[6]  Góp ý khách hàng&#xA;[7]  Quản lý ưu đãi&#xA;&#xA;&#xA;[Thoát]  Đăng xuất" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacingLeft=18;spacingTop=20;fontFamily=Arial;fontSize=14;fillColor=#eeeeee;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="52" y="76" width="264" height="760" as="geometry" /></mxCell>
        <mxCell id="dashboard-head" value="TỔNG QUAN VẬN HÀNH&#xA;Thống kê hệ thống&#xA;Các chỉ số chính của cửa hàng được cập nhật từ dữ liệu thực tế." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="340" y="84" width="1036" height="68" as="geometry" /></mxCell>
