        <mxCell id="detail-note" value="Ghi chú: Khách chưa đăng nhập được yêu cầu đăng nhập; nếu hết tồn kho thì nút thêm giỏ bị vô hiệu hóa." style="text;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="88" y="816" width="1268" height="28" as="geometry" /></mxCell>
