        <mxCell id="login-intro" value="GN  GroupNine&#xA;&#xA;Chào mừng trở lại!&#xA;Đăng nhập để theo dõi đơn hàng&#xA;và nhận ưu đãi riêng cho bạn." style="rounded=0;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=16;fillColor=#eeeeee;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="96" y="128" width="256" height="644" as="geometry" /></mxCell>
        <mxCell id="login-form" value="ĐĂNG NHẬP&#xA;&#xA;Email hoặc số điện thoại&#xA;&#xA;Mật khẩu&#xA;&#xA;Ghi nhớ đăng nhập&#xA;&#xA;Chưa có tài khoản? Đăng ký ngay&#xA;&#xA;Thông báo lỗi / validation" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=24;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="360" y="128" width="296" height="644" as="geometry" /></mxCell>
        <mxCell id="register-shell" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f7f7f7;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="724" y="96" width="644" height="720" as="geometry" /></mxCell>
        <mxCell id="register-form" value="TẠO TÀI KHOẢN MỚI&#xA;Tham gia cộng đồng những người yêu sách.&#xA;&#xA;Họ và tên&#xA;&#xA;Email&#xA;&#xA;Số điện thoại&#xA;&#xA;Mật khẩu (ít nhất 8 ký tự)&#xA;&#xA;Nhập lại mật khẩu&#xA;&#xA;Đã có tài khoản? Đăng nhập&#xA;&#xA;Thông báo lỗi / validation" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacingLeft=24;fontFamily=Arial;fontSize=14;fillColor=#ffffff;strokeColor=#888888;" vertex="1" parent="1"><mxGeometry x="756" y="120" width="588" height="664" as="geometry" /></mxCell>
        <mxCell id="account-note" value="Ghi chú: Email và số điện thoại phải duy nhất; xác nhận mật khẩu phải khớp." style="text;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontFamily=Arial;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="72" y="820" width="1304" height="24" as="geometry" /></mxCell>
